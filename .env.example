# ============================================================================
# JRO9I GAMES — LOCAL ADMIN STUDIO & GITHUB PUBLISHING ENVIRONMENT VARIABLES
# ============================================================================
# IMPORTANT: Keep these credentials strictly in your local .env file or server
# secret store. NEVER expose them with a VITE_ prefix or commit .env to Git.

# 1. Gemini AI API Key (Server-side only, used by Local Admin AI Game Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. GitHub Publishing Credentials (Server-side only, Option B Local Admin Tool)
# Use a Fine-Grained Personal Access Token or GitHub App Installation Token
# Scopes required (least privilege):
#   - Contents: Read and Write (for committing games/ and data/games.json)
#   - Actions: Read-only (for polling GitHub Pages deployment run status)
#   - Pages: Read-only (for verifying deployment state)
GITHUB_TOKEN="YOUR_FINE_GRAINED_GITHUB_PAT_HERE"

# 3. Default Target GitHub Repository Settings (Configurable in Admin UI)
GITHUB_OWNER="your-github-username"
GITHUB_REPO="jro9i-games"
GITHUB_BRANCH="main"

# 4. GitHub Pages Base Path (e.g., "/" for custom domain or "/jro9i-games/" for project pages)
GITHUB_PAGES_BASE_PATH="/jro9i-games/"

# 5. Remote Commit Safety Lock ("true" only when ready to push real commits to GitHub)
ALLOW_REMOTE_GITHUB_COMMIT="false"

# 6. Optional Local OpenAI-Compatible Model Endpoint (e.g. Ollama / LM Studio)
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_MODEL=""

# 7. Runtime URL (Injected automatically in cloud preview environments)
APP_URL="http://localhost:3000"
